rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /tables/{document=**} {
      allow read, write: if request.auth != null;
    }
    match /sessions/{document=**} {
      allow read, write: if request.auth != null;
    }
    match /userStats/{document=**} {
      allow read, write: if request.auth != null;
    }
    match /gameHistory/{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
